// Cyber Range data model — see docs/superpowers/specs/2026-09-18-cyber-range-design.md §3
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  INSTRUCTOR
  AUTHOR
  ADMIN
}

enum CampaignStatus {
  DRAFT
  PUBLISHED
  DISABLED
}

enum DependencyType {
  REQUIRES
  UNLOCKS
  OPTIONAL
  CONVERGES_WITH
}

enum CompletionType {
  VALUE
  CODE
  FINDING
  ENVIRONMENT_STATE
  FILE
}

enum InstanceStatus {
  PENDING
  ACTIVE
  COMPLETED
  ABANDONED
}

enum ChallengeStatus {
  LOCKED
  AVAILABLE
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum EnvStatus {
  PENDING
  PROVISIONING
  RUNNING
  STOPPED
  FAILED
  DESTROYING
  DESTROYED
}

enum ArtifactKind {
  FILE
  PCAP
  BINARY
  SOURCE
  MEMORY_DUMP
  DISK_IMAGE
  DATABASE
  GIT_REPOSITORY
  LOG_ARCHIVE
  CONFIGURATION
  OTHER
}

enum SubmissionType {
  VALUE
  CODE
  FINDING
  EVIDENCE
  ENVIRONMENT_STATE
  FILE
}

enum SubmissionStatus {
  PENDING
  GRADING
  PASSED
  FAILED
  ERROR
}

enum EvidenceKind {
  TERMINAL_TRANSCRIPT
  SCREENSHOT
  PCAP_FILTER
  DEBUGGER_OUTPUT
  SOURCE_CODE
  LOG_EXCERPT
  COMMAND_HISTORY
  FILE
  OTHER
}

enum NotebookType {
  OBSERVATION
  HYPOTHESIS
  EXPERIMENT
  RESULT
  CONCLUSION
  NOTE
}

enum JobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
  DEAD
}

model Profile {
  id          String   @id @db.Uuid
  email       String   @unique
  displayName String
  role        Role     @default(STUDENT)
  createdAt   DateTime @default(now())

  coursesOwned      Course[]           @relation("CourseOwner")
  campaignsAuthored Campaign[]         @relation("CampaignAuthor")
  cohortMemberships CohortMember[]
  campaignInstances CampaignInstance[]
  notebookEntries   NotebookEntry[]
  findings          Finding[]
  submissions       Submission[]
  evidence          Evidence[]
  hintUsages        HintUsage[]
  auditLogs         AuditLog[]
}

model Course {
  id        String   @id @default(cuid())
  name      String
  ownerId   String   @db.Uuid
  owner     Profile  @relation("CourseOwner", fields: [ownerId], references: [id])
  createdAt DateTime @default(now())
  cohorts   Cohort[]
}

model Cohort {
  id          String         @id @default(cuid())
  courseId    String
  course      Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  name        String
  createdAt   DateTime       @default(now())
  members     CohortMember[]
  assignments Assignment[]
}

model CohortMember {
  id        String   @id @default(cuid())
  cohortId  String
  cohort    Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  studentId String   @db.Uuid
  student   Profile  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([cohortId, studentId])
}

model Campaign {
  id             String         @id @default(cuid())
  slug           String         @unique
  name           String
  description    String         @default("")
  status         CampaignStatus @default(DRAFT)
  estimatedHours Int            @default(8)
  difficulty     String         @default("advanced")
  createdById    String         @db.Uuid
  createdBy      Profile        @relation("CampaignAuthor", fields: [createdById], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  versions CampaignVersion[]
}

model CampaignVersion {
  id                String   @id @default(cuid())
  campaignId        String
  campaign          Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  version           Int
  manifestHash      String
  manifestJson      Json
  artifactBundleUri String?
  publishedAt       DateTime @default(now())

  stages       ChallengeStage[]
  environments EnvironmentTemplate[]
  artifacts    Artifact[]
  instances    CampaignInstance[]
  assignments  Assignment[]

  @@unique([campaignId, version])
}

model ChallengeStage {
  id                String          @id @default(cuid())
  campaignVersionId String
  campaignVersion   CampaignVersion @relation(fields: [campaignVersionId], references: [id], onDelete: Cascade)
  slug              String
  title             String
  description       String          @default("")
  estimatedMinutes  Int             @default(60)
  difficulty        String          @default("advanced")
  points            Int             @default(100)
  completionType    CompletionType
  graderName        String?
  visibleByDefault  Boolean         @default(false)
  configJson        Json            @default("{}")

  outgoing  ChallengeDependency[] @relation("DepSource")
  incoming  ChallengeDependency[] @relation("DepTarget")
  artifacts Artifact[]
  instances ChallengeInstance[]
  hints     Hint[]

  @@unique([campaignVersionId, slug])
}

model ChallengeDependency {
  id             String         @id @default(cuid())
  sourceStageId  String
  source         ChallengeStage @relation("DepSource", fields: [sourceStageId], references: [id], onDelete: Cascade)
  targetStageId  String
  target         ChallengeStage @relation("DepTarget", fields: [targetStageId], references: [id], onDelete: Cascade)
  dependencyType DependencyType
  conditionJson  Json           @default("{}")
}

model Assignment {
  id                String          @id @default(cuid())
  campaignVersionId String
  campaignVersion   CampaignVersion @relation(fields: [campaignVersionId], references: [id], onDelete: Cascade)
  cohortId          String
  cohort            Cohort          @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())

  @@unique([campaignVersionId, cohortId])
}

model CampaignInstance {
  id                String         @id @default(cuid())
  campaignVersionId String
  campaignVersion   CampaignVersion @relation(fields: [campaignVersionId], references: [id])
  studentId         String         @db.Uuid
  student           Profile        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status            InstanceStatus @default(PENDING)
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime       @default(now())

  seed               Seed?
  challengeInstances ChallengeInstance[]
  environment        EnvironmentInstance?
  artifactInstances  ArtifactInstance[]
  notebookEntries    NotebookEntry[]
  findings           Finding[]
  evidence           Evidence[]
  domainEvents       DomainEvent[]
  scoreEvents        ScoreEvent[]

  @@unique([campaignVersionId, studentId])
}

model Seed {
  id                 String           @id @default(cuid())
  campaignInstanceId String           @unique
  campaignInstance   CampaignInstance @relation(fields: [campaignInstanceId], references: [id], onDelete: Cascade)
  encryptedSeed      String
  seedVersion        Int              @default(1)
  createdAt          DateTime         @default(now())
}

model EnvironmentTemplate {
  id                String          @id @default(cuid())
  campaignVersionId String
  campaignVersion   CampaignVersion @relation(fields: [campaignVersionId], references: [id], onDelete: Cascade)
  name              String
  definitionJson    Json
}

model EnvironmentInstance {
  id                 String           @id @default(cuid())
  campaignInstanceId String           @unique
  campaignInstance   CampaignInstance @relation(fields: [campaignInstanceId], references: [id], onDelete: Cascade)
  provider           String           @default("vercel-sandbox")
  externalRef        String?
  status             EnvStatus        @default(PENDING)
  createdAt          DateTime         @default(now())
  startedAt          DateTime?
  stoppedAt          DateTime?
  expiresAt          DateTime?
  metadataJson       Json             @default("{}")
}

model ChallengeInstance {
  id                 String           @id @default(cuid())
  campaignInstanceId String
  campaignInstance   CampaignInstance @relation(fields: [campaignInstanceId], references: [id], onDelete: Cascade)
  stageId            String
  stage              ChallengeStage   @relation(fields: [stageId], references: [id])
  status             ChallengeStatus  @default(LOCKED)
  unlockedAt         DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  attemptCount       Int              @default(0)
  scoreAwarded       Int              @default(0)
  instanceStateJson  Json             @default("{}")

  submissions       Submission[]
  findings          Finding[]
  evidence          Evidence[]
  hintUsages        HintUsage[]
  artifactInstances ArtifactInstance[]

  @@unique([campaignInstanceId, stageId])
}

model Artifact {
  id                String          @id @default(cuid())
  campaignVersionId String
  campaignVersion   CampaignVersion @relation(fields: [campaignVersionId], references: [id], onDelete: Cascade)
  stageId           String?
  stage             ChallengeStage? @relation(fields: [stageId], references: [id])
  slug              String
  kind              ArtifactKind
  sourceUri         String?
  generatorName     String?
  metadataJson      Json            @default("{}")

  instances ArtifactInstance[]

  @@unique([campaignVersionId, slug])
}

model ArtifactInstance {
  id                  String             @id @default(cuid())
  artifactId          String
  artifact            Artifact           @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  campaignInstanceId  String
  campaignInstance    CampaignInstance   @relation(fields: [campaignInstanceId], references: [id], onDelete: Cascade)
  challengeInstanceId String?
  challengeInstance   ChallengeInstance? @relation(fields: [challengeInstanceId], references: [id])
  storageUri          String
  sha256              String
  sizeBytes           Int                @default(0)
  generatedAt         DateTime           @default(now())
  metadataJson        Json               @default("{}")

  @@unique([artifactId, campaignInstanceId])
}

model Submission {
  id                  String            @id @default(cuid())
  challengeInstanceId String
  challengeInstance   ChallengeInstance @relation(fields: [challengeInstanceId], references: [id], onDelete: Cascade)
  studentId           String            @db.Uuid
  student             Profile           @relation(fields: [studentId], references: [id])
  type                SubmissionType
  status              SubmissionStatus  @default(PENDING)
  payloadJson         Json              @default("{}")
  submittedAt         DateTime          @default(now())
  gradedAt            DateTime?
  scoreAwarded        Int               @default(0)
  graderFeedbackJson  Json              @default("{}")

  code CodeSubmission?
}

model CodeSubmission {
  id            String     @id @default(cuid())
  submissionId  String     @unique
  submission    Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  language      String
  sourceUri     String?
  sourceText    String?
  entrypoint    String?
  compileLogUri String?
  runtimeLogUri String?
}

model Finding {
  id                  String            @id @default(cuid())
  challengeInstanceId String
  challengeInstance   ChallengeInstance @relation(fields: [challengeInstanceId], references: [id], onDelete: Cascade)
  campaignInstanceId  String
  campaignInstance    CampaignInstance  @relation(fields: [campaignInstanceId], references: [id], onDelete: Cascade)
  studentId           String            @db.Uuid
  student             Profile           @relation(fields: [studentId], references: [id])
  findingType         String
  title               String
  structuredDataJson  Json              @default("{}")
  explanation         String            @default("")
  confidence          String            @default("MEDIUM")
  createdAt           DateTime          @default(now())
}

model Evidence {
  id                  String             @id @default(cuid())
  studentId           String             @db.Uuid
  student             Profile            @relation(fields: [studentId], references: [id])
  campaignInstanceId  String
  campaignInstance    CampaignInstance   @relation(fields: [campaignInstanceId], references: [id], onDelete: Cascade)
  challengeInstanceId String?
  challengeInstance   ChallengeInstance? @relation(fields: [challengeInstanceId], references: [id])
  kind                EvidenceKind
  storageUri          String?
  textContent         String?
  sha256              String
  createdAt           DateTime           @default(now())
}

model NotebookEntry {
  id                 String           @id @default(cuid())
  campaignInstanceId String
  campaignInstance   CampaignInstance @relation(fields: [campaignInstanceId], references: [id], onDelete: Cascade)
  studentId          String           @db.Uuid
  student            Profile          @relation(fields: [studentId], references: [id])
  type               NotebookType
  title              String
  content            String           @default("")
  confidence         String           @default("MEDIUM")
  linksJson          Json             @default("{}")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model Hint {
  id           String         @id @default(cuid())
  stageId      String
  stage        ChallengeStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  level        Int
  content      String
  pointPenalty Int            @default(0)

  usages HintUsage[]

  @@unique([stageId, level])
}

model HintUsage {
  id                  String            @id @default(cuid())
  hintId              String
  hint                Hint              @relation(fields: [hintId], references: [id], onDelete: Cascade)
  studentId           String            @db.Uuid
  student             Profile           @relation(fields: [studentId], references: [id])
  challengeInstanceId String
  challengeInstance   ChallengeInstance @relation(fields: [challengeInstanceId], references: [id], onDelete: Cascade)
  usedAt              DateTime          @default(now())
  penaltyApplied      Int               @default(0)

  @@unique([hintId, challengeInstanceId])
}

model DomainEvent {
  id                 String           @id @default(cuid())
  campaignInstanceId String
  campaignInstance   CampaignInstance @relation(fields: [campaignInstanceId], references: [id], onDelete: Cascade)
  eventType          String
  payloadJson        Json             @default("{}")
  idempotencyKey     String           @unique
  createdAt          DateTime         @default(now())

  processed ProcessedEvent[]
}

model ProcessedEvent {
  id          String      @id @default(cuid())
  eventId     String
  event       DomainEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  handlerName String
  processedAt DateTime    @default(now())

  @@unique([eventId, handlerName])
}

model Job {
  id             String    @id @default(cuid())
  type           String
  payloadJson    Json      @default("{}")
  status         JobStatus @default(QUEUED)
  idempotencyKey String    @unique
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  lockedAt       DateTime?
  runAfter       DateTime  @default(now())
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, runAfter])
}

model ScoreEvent {
  id                 String           @id @default(cuid())
  campaignInstanceId String
  campaignInstance   CampaignInstance @relation(fields: [campaignInstanceId], references: [id], onDelete: Cascade)
  stageSlug          String?
  category           String
  delta              Int
  reason             String
  createdAt          DateTime         @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @db.Uuid
  actor      Profile? @relation(fields: [actorId], references: [id])
  action     String
  targetType String?
  targetId   String?
  metaJson   Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([action, createdAt])
}
